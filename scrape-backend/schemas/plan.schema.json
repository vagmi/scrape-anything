{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "type": "object",
  "required": ["plan_id", "kind", "source", "fields", "rationale"],
  "additionalProperties": false,
  "properties": {
    "plan_id":   { "type": "string" },
    "kind":      { "enum": ["listing", "event"] },
    "source":    { "enum": ["next_data", "json_ld", "dom"] },
    "rationale": { "type": "string" },
    "items": {
      "oneOf": [
        { "type": "object", "required": ["path"],
          "additionalProperties": false,
          "properties": { "path": { "type": "string" } } },
        { "type": "object", "required": ["selector"],
          "additionalProperties": false,
          "properties": { "selector": { "type": "string" } } }
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["name", "path"],
            "additionalProperties": false,
            "properties": {
              "name":            { "type": "string" },
              "type":            { "enum": ["string", "url", "datetime", "number", "bool"] },
              "path":            { "type": "string" },
              "resolve_against": { "type": "string" },
              "default":         {}
            }
          },
          {
            "type": "object",
            "required": ["name", "selector", "extract"],
            "additionalProperties": false,
            "properties": {
              "name":        { "type": "string" },
              "type":        { "enum": ["string", "url", "datetime", "number", "bool"] },
              "selector":    { "type": "string" },
              "extract":     { "type": "string", "pattern": "^(text|html|attr:.+)$" },
              "resolve_url": { "type": "boolean" },
              "default":     {}
            }
          }
        ]
      }
    },
    "post_processors": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "object", "required": ["op", "field"],
            "additionalProperties": false,
            "properties": {
              "op":    { "enum": ["trim", "lower", "upper", "parse_date"] },
              "field": { "type": "string" }
            } },
          { "type": "object", "required": ["op", "field", "pattern", "replacement"],
            "additionalProperties": false,
            "properties": {
              "op":          { "const": "regex_replace" },
              "field":       { "type": "string" },
              "pattern":     { "type": "string" },
              "replacement": { "type": "string" }
            } },
          { "type": "object", "required": ["op", "field", "to"],
            "additionalProperties": false,
            "properties": {
              "op":    { "const": "coerce" },
              "field": { "type": "string" },
              "to":    { "enum": ["number", "bool"] }
            } }
        ]
      }
    }
  }
}
