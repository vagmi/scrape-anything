{
  "manifest_version": 3,
  "name": "Scrape Anything",
  "version": "0.4.0",
  "description": "Agentic LLM scraping for any web page. Local backend on http://localhost:4546.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "userScripts"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Scrape this page",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["dom-signals.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
