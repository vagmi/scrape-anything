{
  "manifest_version": 3,
  "name": "Luma Scraper (agentic)",
  "version": "0.3.0",
  "description": "LLM-planned scraping for any web page. Local backend on http://localhost:4546.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "userScripts"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Scrape this page",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
