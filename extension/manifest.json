{
  "manifest_version": 3,
  "name": "Scrape Anything",
  "version": "0.6.0",
  "description": "Agentic LLM scraping for any web page. Local backend on http://localhost:4546.",
  "permissions": ["activeTab", "tabs", "scripting", "downloads", "storage", "userScripts", "sidePanel", "debugger", "tabGroups"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Scrape this page"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["dom-signals.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
